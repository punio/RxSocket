<?xml version="1.0"?>
<package >
  <metadata>
    <id>Punio.RxSocket</id>
    <version>1.2.0</version>
    <title>RxSocket</title>
    <authors>punio</authors>
    <owners>punio</owners>
    <license type="expression">MIT</license>
    <readme>docs\README.md</readme>
    <projectUrl>https://github.com/punio/RxSocket</projectUrl>
    <!--
    <iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>
-->
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Tiny socket wrapper for Reactive Extensions</description>
    <releaseNotes>
* 1.2.0    - Target .NET 6 and later and improve TCP and UDP receive performance.
* 1.1.18   - I fixed a issue. Please look at github.
* 1.1.16   - I fixed a issue. Please look at github.
* 1.1.15   - I fixed a issue. Please look at github.
* 1.1.14   - I fixed a issue. Please look at github.
* 1.1.13   - I fixed a issue. Please look at github.
* 1.1.12   - Support .NET Standard 2.0
* 1.1.11   - Add .NET Core 3.0
    </releaseNotes>
    <copyright>Copyright 2017</copyright>
    <tags>Socket Observable Reactive Extensions</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="System.Reactive" version="7.0.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\LICENSE" target="docs\LICENSE"/>
    <file src="..\README.md" target="docs\"/>
    <file src="RxSocket\bin\Release\net6.0\RxSocket.dll" target="lib\net6.0"/>
    <file src="RxSocket\bin\Release\net6.0\RxSocket.pdb" target="lib\net6.0"/>
  </files>
</package>
